{
  "name": "@kevin/opencode-todo",
  "version": "0.1.0",
  "private": true,
  "description": "OpenCode v2 plugin: an OMP-style phased todo tool with reminders, /todo commands, and a todo-discipline skill.",
  "license": "MIT",
  "files": [
    "dist",
    "src",
    "index.mjs",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./server": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
