    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vite-plus": "1.0.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "2.0.21",
    "@opentui/solid": ">=0.5.14",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
